# hydra-oidc-go — sample environment (copy to .env for local dev)

# Hydra admin API (or the hydra-dispatcher URL; set HYDRA_API_PATH_PREFIX="" for the dispatcher)
HYDRA_ADMIN_BASE_URL=http://hydra:4445
# HYDRA_API_PATH_PREFIX=/admin

# This app
BASE_URL=http://oidc.hydra.localhost
APP_SECRET=change-me-at-least-16-bytes
# COOKIE_PATH=/auth/oidc

# Upstream OIDC provider — either discovery (OIDC_ISSUER) or explicit endpoints.
# OIDC_ISSUER=https://accounts.example.com
OIC_AUTHORIZE_ENDPOINT=https://fcp.integ01.dev-franceconnect.fr/api/v1/authorize
OIDC_TOKEN_ENDPOINT=https://fcp.integ01.dev-franceconnect.fr/api/v1/token
OIDC_USERINFO_ENDPOINT=https://fcp.integ01.dev-franceconnect.fr/api/v1/userinfo
OIDC_JWKS_ENDPOINT=https://fcp.integ01.dev-franceconnect.fr/api/v1/jwks
OIDC_LOGOUT_ENDPOINT=https://fcp.integ01.dev-franceconnect.fr/api/v1/logout?%s
CLIENT_ID=
CLIENT_SECRET=
OIDC_SCOPE=openid identite_pivot email
# PARAMS_TO_INSERT={"acr_values":"eidas1"}
# PARAMS_TO_DELETE=["approval_prompt"]

# Security (strict by default; relax only for quirky providers)
# OIDC_PKCE_ENABLED=true
# OIDC_VERIFY_SIGNATURE=true
# OIDC_ID_TOKEN_SIGNING_ALGS=RS256
# OIDC_SKIP_USERINFO=false

# Consent / claims
CONSENT_AUTO_ACCEPT=true
FILTER_CLAIMS_BY_SCOPE=false

# Redirects
POST_LOGOUT_REDIRECT_URL=http://localhost:8000
REDIRECT_ON_ERROR_URL=http://localhost:8000

# Optional Redis (only stores the upstream id_token for logout; otherwise an encrypted cookie)
# REDIS_DSN=redis://redis:6379
# HYDRA_OIDC_REDIS_PREFIX=hydraoidc
# HYDRA_OIDC_REDIS_TTL=3600

LISTEN_ADDR=:8080
